# 数据库（本地开发默认 SQLite；生产切 MySQL 8）
#DATABASE_URL=sqlite:///./dev.db
 DATABASE_URL=mysql+pymysql://user:password@localhost:3306/finance

# JWT 认证
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Redis / Celery（Redis 仅作 broker）
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ============ 外部 AI 服务（三模式） ============
# 模式：preset（默认，无需任何 Key）/ auto（real 失败自动回退 preset）/ real（失败即失败）
OCR_MODE=preset
LLM_MODE=preset

# ---- 百度 OCR（real 模式必需）----
# 百度智能云「文字识别」应用：API Key / Secret Key（应用列表页获取）
OCR_API_KEY=
OCR_SECRET_KEY=

# ---- DeepSeek LLM（real 模式必需）----
# DeepSeek 开放平台 API Key；base_url 默认官方 https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 模型名（官方 OpenAI 兼容，以官方文档为准）
LLM_MODEL=deepseek-v4-flash

# 附件存储目录（real 模式解析读取该目录下的附件文件）
UPLOAD_DIR=uploads
